[
  { "id": "tab1", "type": "tab", "label": "Flood alarm response", "info": "Reference flow: flood alarm -> nearby PTZ cameras to preset -> notify duty officers. Critical escalation runs in Temporal (IncidentEscalation)." },
  { "id": "kafkaIn", "type": "kafkajs-consumer", "z": "tab1", "name": "omnilink.alarms.v1", "topic": "omnilink.alarms.v1", "groupid": "nodered-flood", "x": 140, "y": 100, "wires": [["parse"]] },
  { "id": "parse", "type": "json", "z": "tab1", "name": "", "property": "payload", "x": 310, "y": 100, "wires": [["isFlood"]] },
  { "id": "isFlood", "type": "switch", "z": "tab1", "name": "new flood alarm?", "property": "payload", "propertyType": "msg",
    "rules": [{ "t": "jsonata_exp", "v": "rule_id = 'flood-high' and state = 'active_unack' and occurrences = 1", "vt": "jsonata" }],
    "checkall": "true", "outputs": 1, "x": 480, "y": 100, "wires": [["lookup"]] },
  { "id": "lookup", "type": "omnilink-asset", "z": "tab1", "name": "sensor location", "server": "cfg",
    "deviceId": "", "x": 670, "y": 100, "wires": [["setNear"]] },
  { "id": "setNear", "type": "change", "z": "tab1", "name": "cameras near sensor",
    "rules": [{ "t": "set", "p": "lat", "pt": "msg", "to": "payload.lat", "tot": "msg" },
              { "t": "set", "p": "lon", "pt": "msg", "to": "payload.lon", "tot": "msg" },
              { "t": "set", "p": "deviceType", "pt": "msg", "to": "Camera", "tot": "str" }],
    "x": 860, "y": 100, "wires": [["near"]] },
  { "id": "near", "type": "omnilink-asset", "z": "tab1", "name": "PTZ within 300 m", "server": "cfg", "radius": 300, "x": 1050, "y": 100, "wires": [["split"]] },
  { "id": "split", "type": "split", "z": "tab1", "x": 1210, "y": 100, "wires": [["preset"]] },
  { "id": "preset", "type": "change", "z": "tab1", "name": "goto preset 'flood'",
    "rules": [{ "t": "set", "p": "deviceId", "pt": "msg", "to": "payload.id", "tot": "msg" },
              { "t": "set", "p": "connectorId", "pt": "msg", "to": "payload.connector_id", "tot": "msg" },
              { "t": "set", "p": "action", "pt": "msg", "to": "ptz.goto_preset", "tot": "str" },
              { "t": "set", "p": "params", "pt": "msg", "to": "{\"preset\":\"flood\"}", "tot": "json" }],
    "x": 1370, "y": 100, "wires": [["cmd"]] },
  { "id": "cmd", "type": "omnilink-command", "z": "tab1", "name": "PTZ", "server": "cfg", "x": 1530, "y": 100, "wires": [["notify"]] },
  { "id": "notify", "type": "omnilink-notify", "z": "tab1", "name": "duty officers", "server": "cfg", "group": "duty-officers", "channels": "sms,push", "subject": "Flood alarm: cameras repositioned", "x": 1700, "y": 100, "wires": [[]] },
  { "id": "cfg", "type": "omnilink-config", "name": "OmniLink", "baseUrl": "", "tokenUrl": "" }
]
