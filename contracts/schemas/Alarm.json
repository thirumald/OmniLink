{
  "$defs": {
    "AlarmState": {
      "description": "ISA-18.2 alarm states.",
      "enum": [
        "active_unack",
        "active_ack",
        "cleared_unack",
        "cleared",
        "shelved"
      ],
      "title": "AlarmState",
      "type": "string"
    }
  },
  "$id": "https://schemas.omnilink.local/v1/Alarm.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acked At"
    },
    "acked_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acked By"
    },
    "alarm_id": {
      "title": "Alarm Id",
      "type": "string"
    },
    "attribute": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribute"
    },
    "cleared_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleared At"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "last_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Value"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "occurrences": {
      "default": 1,
      "title": "Occurrences",
      "type": "integer"
    },
    "priority": {
      "maximum": 4,
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "raised_at": {
      "format": "date-time",
      "title": "Raised At",
      "type": "string"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shelved_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shelved Until"
    },
    "state": {
      "$ref": "#/$defs/AlarmState",
      "default": "active_unack"
    },
    "tenant": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Tenant",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "rule_id",
    "entity_id",
    "priority",
    "message"
  ],
  "title": "Alarm",
  "type": "object"
}
