{
  "$defs": {
    "CommandStatus": {
      "enum": [
        "pending",
        "sent",
        "acked",
        "failed",
        "expired",
        "rejected"
      ],
      "title": "CommandStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.omnilink.local/v1/CommandResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "title": "Command Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CommandStatus"
    },
    "tenant": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "command_id",
    "device_id",
    "status"
  ],
  "title": "CommandResult",
  "type": "object"
}
