{
  "$defs": {
    "Severity": {
      "enum": [
        "info",
        "warning",
        "minor",
        "major",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://schemas.omnilink.local/v1/DeviceEvent.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "ingest_ts": {
      "format": "date-time",
      "title": "Ingest Ts",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "protocol": {
      "title": "Protocol",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "info"
    },
    "source_ts": {
      "format": "date-time",
      "title": "Source Ts",
      "type": "string"
    },
    "tenant": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "device_id",
    "event_type",
    "source_ts",
    "protocol"
  ],
  "title": "DeviceEvent",
  "type": "object"
}
