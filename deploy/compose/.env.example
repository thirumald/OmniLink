# Copy to .env and change every secret before any shared deployment.
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
OIDC_GATEWAY_SECRET=change-me-gateway-secret
NODERED_CLIENT_SECRET=change-me-nodered
TEMPORAL_CLIENT_SECRET=change-me-temporal
ASSISTANT_CLIENT_SECRET=change-me-assistant
CENTRIFUGO_API_KEY=change-me-centrifugo
PARTNER_NCM_KEY=change-me-partner-key
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# AI: point at vLLM (profile ai-gpu) or Ollama (profile ai)
OMNILINK_LLM_URL=http://ollama:11434/v1
OMNILINK_LLM_MODEL=qwen2.5:7b-instruct
OMNILINK_EMBED_MODEL=bge-m3
# dev only: header-based identity (never in production)
OMNILINK_AUTH_MODE=dev
