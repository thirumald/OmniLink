# Copy to .env (scripts/bringup.sh preflight does this and generates random secrets).
# Change every value before a shared deployment. Never commit .env.
POSTGRES_USER=omnilink
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
MQTT_USER=omnilink
MQTT_PASSWORD=change-me-mqtt
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
OIDC_GATEWAY_SECRET=change-me-gateway
NODERED_CLIENT_SECRET=change-me-nodered
TEMPORAL_CLIENT_SECRET=change-me-temporal
ASSISTANT_CLIENT_SECRET=change-me-assistant
ONBOARDING_CLIENT_SECRET=change-me-onboarding
CENTRIFUGO_API_KEY=change-me-centrifugo
PARTNER_NCM_KEY=change-me-partner-key
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# AI: Ollama on CPU (profile ai) or vLLM on GPU (profile ai-gpu: OMNILINK_LLM_URL=http://vllm:8000/v1)
OMNILINK_LLM_URL=http://ollama:11434/v1
OMNILINK_LLM_MODEL=qwen2.5:7b-instruct
OMNILINK_EMBED_MODEL=bge-m3
# Simulators: seconds before the AQ spike / pump pressure fault (exercise alarms and workflows)
SIM_SPIKE_AFTER=300
SIM_FAULT_AFTER=600
